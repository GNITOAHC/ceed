# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CEED run outputs. The artifact store and run records are reproducible from a
# corpus manifest and a configuration hash, so they are not version controlled.
runs/
store/
wandb/
outputs/

# Assembled corpora: images and examples streamed from the source datasets, and
# rebuildable by scripts/build_corpus.py from the recorded manifest.
data/
.ceed-infer-images/

# Merged standalone checkpoints (~15 GB each), rebuildable by
# scripts/merge_adapter.py from a run's adapter.
merged/
logs/
